        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n  <title>Qube Industrial Insights</title>\n  <style>\n    *{box-sizing:border-box;margin:0;padding:0}\n    body{background:#f0f2f0;font-family:sans-serif;min-height:100vh;padding:24px}\n    .page{max-width:700px;margin:auto}\n    .topbar{display:flex;align-items:center;gap:12px;margin-bottom:20px}\n    .topbar h1{color:#ff6d5a;font-size:1.3em;flex:1}\n    .topbar span{font-size:12px;color:#aaa}\n    .card{background:#fff;border-radius:14px;padding:28px;margin-bottom:16px;box-shadow:0 2px 12px rgba(0,0,0,0.06)}\n    .sec-title{font-size:11px;font-weight:700;color:#999;text-transform:uppercase;letter-spacing:.07em;margin-bottom:12px}\n    /* Device selector */\n    .site-group{margin-bottom:10px}\n    .site-label{font-size:11px;font-weight:700;color:#ff6d5a;text-transform:uppercase;letter-spacing:.05em;padding:4px 0;margin-bottom:6px;border-bottom:1px solid #f5e8e6}\n    .device-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n    .dev-btn{padding:8px 10px;border:1px solid #e5e5e5;border-radius:8px;font-size:12px;cursor:pointer;background:#fafafa;color:#444;text-align:left;transition:all .12s;line-height:1.35}\n    .dev-btn .dev-id{font-weight:700;color:#222;display:block;font-size:12px}\n    .dev-btn .dev-label{color:#999;font-size:11px}\n    .dev-btn.active{border-color:#ff6d5a;background:#fff4f2;color:#c0421a}\n    .dev-btn.active .dev-id{color:#c0421a}\n    /* Reading groups */\n    .rg-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}\n    .rg-btn{padding:5px 12px;border:1px solid #ddd;border-radius:6px;font-size:12px;background:#fff;cursor:pointer;color:#555;transition:all .1s;font-weight:600}\n    .rg-btn:hover{background:#f4f7f6}\n    .rg-btn.sel{background:#15171c;color:#fff;border-color:#15171c}\n    .chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}\n    .chip{display:flex;align-items:center;gap:5px;padding:5px 11px;border:1px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;color:#555;transition:all .12s;user-select:none}\n    .chip input{width:12px;height:12px;accent-color:#ff6d5a;margin:0}\n    .chip:has(input:checked){border-color:#ff6d5a;background:#fff4f2;color:#c0421a;font-weight:600}\n    /* Time */\n    .presets{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}\n    .preset{padding:5px 12px;border:1px solid #ddd;border-radius:6px;font-size:12px;background:#fff;cursor:pointer;color:#555;transition:all .1s}\n    .preset.active,.preset:hover{background:#fff4f2;border-color:#ff6d5a;color:#c0421a}\n    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n    input[type=datetime-local]{width:100%;padding:9px 12px;border:1px solid #ddd;border-radius:8px;font-size:13px;color:#222;outline:none;background:#fff;transition:border .15s}\n    input[type=datetime-local]:focus{border-color:#ff6d5a}\n    /* Run button */\n    .run{width:100%;padding:14px;background:#ff6d5a;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;transition:background .15s;letter-spacing:.02em}\n    .run:hover{background:#e0503d}\n    .run:disabled{background:#ddd;color:#aaa;cursor:not-allowed}\n    /* Results */\n    #result{display:none;margin-top:0}\n    .r-label{font-size:11px;font-weight:700;color:#999;text-transform:uppercase;letter-spacing:.07em;margin-bottom:12px}\n    .device-card{border-left:5px solid #ff6d5a;background:#fafafa;padding:16px 18px;border-radius:0 8px 8px 0;margin-bottom:12px}\n    .device-title{font-weight:700;color:#15171c;font-size:.95em;margin-bottom:8px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n    .badge{background:#fff0ed;color:#c0421a;font-size:11px;padding:2px 8px;border-radius:10px;font-weight:600}\n    .insight{white-space:pre-wrap;font-size:14px;color:#2c3e50;line-height:1.7}\n    .loader{text-align:center;padding:32px;color:#aaa;font-size:14px}\n    .spinner{display:inline-block;width:16px;height:16px;border:2px solid #eee;border-top-color:#ff6d5a;border-radius:50%;animation:spin .7s linear infinite;margin-right:8px;vertical-align:middle}\n    @keyframes spin{to{transform:rotate(360deg)}}\n    .err{background:#fff0f0;border:1px solid #fcc;border-radius:8px;padding:14px;color:#c00;font-size:13px}\n    footer{text-align:center;font-size:11px;color:#ccc;margin-top:12px;padding-top:12px;border-top:1px solid #f0f0f0}\n    .sel-summary{font-size:12px;color:#888;margin-top:8px;min-height:18px}\n    .sel-summary span{color:#ff6d5a;font-weight:700}\n  </style>\n</head>\n<body>\n<div class=\"page\">\n\n  <div class=\"topbar\">\n    <h1>&#9889; Qube Industrial Insights</h1>\n    <span id=\"clock\"></span>\n  </div>\n\n  <!-- STEP 1: Device -->\n  <div class=\"card\">\n    <div class=\"sec-title\">1 — Select Device</div>\n\n    <div class=\"site-group\">\n      <div class=\"site-label\">SDF — Power Room</div>\n      <div class=\"device-grid\">\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_TR1')\"><span class=\"dev-id\">TR1</span><span class=\"dev-label\">Main Transformer 1 · PM1</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_TR2')\"><span class=\"dev-id\">TR2</span><span class=\"dev-label\">Main Transformer 2 · PM2</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_PLANT2')\"><span class=\"dev-id\">PLANT2</span><span class=\"dev-label\">Plant 2 · PM11</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_PLANT3')\"><span class=\"dev-id\">PLANT3</span><span class=\"dev-label\">Plant 3 · PM12</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_PLANT4')\"><span class=\"dev-id\">PLANT4</span><span class=\"dev-label\">Plant 4 · PM8</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_GEA_CHILLER')\"><span class=\"dev-id\">GEA CHILLER</span><span class=\"dev-label\">Chiller · PM7</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_90KW_COMP')\"><span class=\"dev-id\">90KW COMP</span><span class=\"dev-label\">Compressor · PM10</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_BM_PLANT')\"><span class=\"dev-id\">BM PLANT</span><span class=\"dev-label\">BM Plant · PM9</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_MY_COM')\"><span class=\"dev-id\">MY COM</span><span class=\"dev-label\">MY Compressor · PM13</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_LP_COM')\"><span class=\"dev-id\">LP COM</span><span class=\"dev-label\">LP Compressor · PM14</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_SYRUP_ROOM')\"><span class=\"dev-id\">SYRUP ROOM</span><span class=\"dev-label\">Syrup Room · PM15</span></button>\n      </div>\n    </div>\n\n    <div class=\"site-group\">\n      <div class=\"site-label\">SDF — Generators</div>\n      <div class=\"device-grid\">\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_CAT_GEN')\"><span class=\"dev-id\">CAT GEN</span><span class=\"dev-label\">CAT Generator · PM4</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_PowerRoom_CUMMINS_GEN')\"><span class=\"dev-id\">CUMMINS GEN</span><span class=\"dev-label\">Cummins Gen · PM5</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_NewLand_TR3')\"><span class=\"dev-id\">NEWLAND TR3</span><span class=\"dev-label\">Transformer 3 · PM1</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_SDF_NewLand_KIR_Gen')\"><span class=\"dev-id\">KIR GEN</span><span class=\"dev-label\">Kirloskar Gen · PM2</span></button>\n      </div>\n    </div>\n\n    <div class=\"site-group\">\n      <div class=\"site-label\">ICF — Power Room</div>\n      <div class=\"device-grid\">\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_PowerRoom_A_Panel')\"><span class=\"dev-id\">A PANEL</span><span class=\"dev-label\">Panel A · PM1</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_PowerRoom_BC_Panel')\"><span class=\"dev-id\">BC PANEL</span><span class=\"dev-label\">Panel BC · PM4</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_PowerRoom_D_Panel')\"><span class=\"dev-id\">D PANEL</span><span class=\"dev-label\">Panel D · PM5</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_PowerRoom_HT_Indoor')\"><span class=\"dev-id\">HT INDOOR</span><span class=\"dev-label\">HT Indoor · PM2</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_PowerRoom_HT_Outdoor')\"><span class=\"dev-id\">HT OUTDOOR</span><span class=\"dev-label\">HT Outdoor · PM3</span></button>\n      </div>\n    </div>\n\n    <div class=\"site-group\">\n      <div class=\"site-label\">ICF — Cold Room &amp; Generators</div>\n      <div class=\"device-grid\">\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_ColdRoom_ETP')\"><span class=\"dev-id\">COLD ETP</span><span class=\"dev-label\">ETP · PM1</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_ColdRoom_NCR_CH1')\"><span class=\"dev-id\">NCR CH1</span><span class=\"dev-label\">NCR Channel 1 · PM2</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_ColdRoom_NCR_CH2')\"><span class=\"dev-id\">NCR CH2</span><span class=\"dev-label\">NCR Channel 2 · PM3</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_ColdRoom_NCR_CH3')\"><span class=\"dev-id\">NCR CH3</span><span class=\"dev-label\">NCR Channel 3 · PM4</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_GENERATOR_CAT')\"><span class=\"dev-id\">ICF CAT GEN</span><span class=\"dev-label\">CAT Generator · PM2</span></button>\n        <button class=\"dev-btn\" onclick=\"selectDevice(this,'CCS_ICF_GENERATOR_CUMMINS')\"><span class=\"dev-id\">ICF CUMMINS</span><span class=\"dev-label\">Cummins Gen · PM1</span></button>\n      </div>\n    </div>\n\n    <div class=\"sel-summary\" id=\"devSummary\">No device selected</div>\n  </div>\n\n  <!-- STEP 2: Readings -->\n  <div class=\"card\">\n    <div class=\"sec-title\">2 — Select Readings</div>\n\n    <div class=\"rg-row\">\n      <button class=\"rg-btn\" onclick=\"applyGroup('energy')\">⚡ Energy</button>\n      <button class=\"rg-btn\" onclick=\"applyGroup('power')\">🔌 Power</button>\n      <button class=\"rg-btn\" onclick=\"applyGroup('voltage')\">📊 Voltage</button>\n      <button class=\"rg-btn\" onclick=\"applyGroup('current')\">〰 Current</button>\n      <button class=\"rg-btn\" onclick=\"applyGroup('all')\">✦ All</button>\n      <button class=\"rg-btn\" onclick=\"applyGroup('none')\">✕ Clear</button>\n    </div>\n\n    <div class=\"chips\" id=\"readingChips\">\n      <!-- populated by selectDevice() -->\n      <span style=\"font-size:13px;color:#bbb\">Select a device first</span>\n    </div>\n  </div>\n\n  <!-- STEP 3: Time -->\n  <div class=\"card\">\n    <div class=\"sec-title\">3 — Time Range</div>\n    <div class=\"presets\">\n      <button class=\"preset\" onclick=\"setPreset(1,'h',this)\">1h</button>\n      <button class=\"preset\" onclick=\"setPreset(6,'h',this)\">6h</button>\n      <button class=\"preset active\" onclick=\"setPreset(24,'h',this)\">24h</button>\n      <button class=\"preset\" onclick=\"setPreset(7,'d',this)\">7d</button>\n      <button class=\"preset\" onclick=\"setPreset(30,'d',this)\">30d</button>\n    </div>\n    <div class=\"grid2\">\n      <div>\n        <div style=\"font-size:11px;color:#999;margin-bottom:4px\">FROM</div>\n        <input type=\"datetime-local\" id=\"from\"/>\n      </div>\n      <div>\n        <div style=\"font-size:11px;color:#999;margin-bottom:4px\">TO</div>\n        <input type=\"datetime-local\" id=\"to\"/>\n      </div>\n    </div>\n  </div>\n\n  <!-- RUN -->\n  <button class=\"run\" id=\"runBtn\" onclick=\"runInsights()\">Run AI Analysis</button>\n\n  <!-- RESULTS -->\n  <div id=\"result\" style=\"margin-top:16px\">\n    <div class=\"card\">\n      <div class=\"r-label\">Analysis Results</div>\n      <div id=\"cards\"></div>\n      <footer>Qube AI Reasoning Engine &middot; TimescaleDB &middot; <span id=\"ts\"></span></footer>\n    </div>\n  </div>\n  <div id=\"errBox\" class=\"err\" style=\"display:none;margin-top:16px\"></div>\n\n</div>\n\n<script>\n  // All devices and their available readings from DB\n  const DEVICE_READINGS = {\n    'CCS_SDF_PowerRoom_TR1':        ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','PF','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_SDF_PowerRoom_TR2':        ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','PF','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_SDF_PowerRoom_CAT_GEN':    ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_SDF_PowerRoom_CUMMINS_GEN':['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_SDF_PowerRoom_PLANT2':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_PLANT3':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_PLANT4':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_GEA_CHILLER':['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_90KW_COMP':  ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_BM_PLANT':   ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_MY_COM':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_LP_COM':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_PowerRoom_SYRUP_ROOM': ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_SDF_NewLand_TR3':          ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','PF','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_SDF_NewLand_KIR_Gen':      ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_ICF_PowerRoom_A_Panel':    ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','PF','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_ICF_PowerRoom_BC_Panel':   ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','PF','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_ICF_PowerRoom_D_Panel':    ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','PF','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_ICF_PowerRoom_HT_Indoor':  ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_ICF_PowerRoom_HT_Outdoor': ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_ICF_ColdRoom_ETP':         ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_ICF_ColdRoom_NCR_CH1':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_ICF_ColdRoom_NCR_CH2':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_ICF_ColdRoom_NCR_CH3':     ['ACT_POW','APP_POW','C_AVG','ENERGY','PF','V_AVG'],\n    'CCS_ICF_GENERATOR_CAT':        ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','V_AVG','V_LL1','V_LL2','V_LL3'],\n    'CCS_ICF_GENERATOR_CUMMINS':    ['ACT_POW','APP_POW','C_AVG','C_IL1','C_IL2','C_IL3','ENERGY','V_AVG','V_LL1','V_LL2','V_LL3']\n  };\n\n  // Reading groups\n  const GROUPS = {\n    energy:  ['ENERGY','ACT_POW','APP_POW'],\n    power:   ['ACT_POW','APP_POW','PF'],\n    voltage: ['V_AVG','V_LL1','V_LL2','V_LL3'],\n    current: ['C_AVG','C_IL1','C_IL2','C_IL3'],\n    all:     null,\n    none:    []\n  };\n\n  // Reading labels\n  const R_LABELS = {\n    ACT_POW:'Active Power', APP_POW:'Apparent Power', ENERGY:'Energy',\n    PF:'Power Factor', V_AVG:'Voltage Avg', V_LL1:'Voltage L1',\n    V_LL2:'Voltage L2', V_LL3:'Voltage L3', C_AVG:'Current Avg',\n    C_IL1:'Current L1', C_IL2:'Current L2', C_IL3:'Current L3'\n  };\n\n  let selectedDevice = null;\n\n  function pad(n){return String(n).padStart(2,'0')}\n  function toLocal(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes())}\n\n  function setPreset(n,u,btn){\n    document.querySelectorAll('.preset').forEach(b=>b.classList.remove('active'));\n    if(btn)btn.classList.add('active');\n    const now=new Date(),from=new Date(now);\n    u==='h'?from.setHours(from.getHours()-n):from.setDate(from.getDate()-n);\n    document.getElementById('from').value=toLocal(from);\n    document.getElementById('to').value=toLocal(now);\n  }\n  setPreset(24,'h',null);\n\n  function selectDevice(btn, device){\n    document.querySelectorAll('.dev-btn').forEach(b=>b.classList.remove('active'));\n    btn.classList.add('active');\n    selectedDevice = device;\n    document.getElementById('devSummary').innerHTML = 'Selected: <span>'+device+'</span>';\n    renderChips(device);\n  }\n\n  function renderChips(device){\n    const readings = DEVICE_READINGS[device] || [];\n    const container = document.getElementById('readingChips');\n    // default: check energy+power group\n    const defaults = ['ACT_POW','APP_POW','ENERGY','PF'];\n    container.innerHTML = readings.map(r=>\n      `<label class=\"chip\"><input type=\"checkbox\" value=\"${r}\" ${defaults.includes(r)?'checked':''}> <span title=\"${R_LABELS[r]||r}\">${r}</span></label>`\n    ).join('');\n  }\n\n  function applyGroup(group){\n    document.querySelectorAll('.rg-btn').forEach(b=>b.classList.remove('sel'));\n    event.target.classList.add('sel');\n    const target = GROUPS[group];\n    document.querySelectorAll('#readingChips input').forEach(cb=>{\n      if(target === null) cb.checked = true;\n      else cb.checked = target.includes(cb.value);\n    });\n  }\n\n  async function runInsights(){\n    if(!selectedDevice){alert('Select a device first');return}\n    const checked = [...document.querySelectorAll('#readingChips input:checked')].map(i=>i.value);\n    if(!checked.length){alert('Select at least one reading');return}\n    const from = document.getElementById('from').value;\n    const to   = document.getElementById('to').value;\n    if(!from||!to){alert('Set a time range');return}\n\n    const btn = document.getElementById('runBtn');\n    btn.disabled=true; btn.textContent='Running…';\n    document.getElementById('errBox').style.display='none';\n    document.getElementById('cards').innerHTML='<div class=\"loader\"><span class=\"spinner\"></span>Fetching telemetry and running AI analysis…</div>';\n    document.getElementById('result').style.display='block';\n    document.getElementById('result').scrollIntoView({behavior:'smooth'});\n\n    try{\n      const params = new URLSearchParams({\n        device:   selectedDevice,\n        readings: checked.join(','),\n        from:     new Date(from).toISOString(),\n        to:       new Date(to).toISOString()\n      });\n      const resp = await fetch(window.location.origin+'/webhook/energy-insights?'+params.toString());\n      if(!resp.ok) throw new Error('Webhook returned '+resp.status);\n      const html = await resp.text();\n      const doc  = new DOMParser().parseFromString(html,'text/html');\n      const incoming = doc.querySelectorAll('.device-card');\n      if(incoming.length){\n        document.getElementById('cards').innerHTML='';\n        incoming.forEach(c=>document.getElementById('cards').appendChild(document.importNode(c,true)));\n      } else {\n        document.getElementById('cards').innerHTML='<div class=\"loader\">No data found for that device / time range.</div>';\n      }\n      document.getElementById('ts').textContent = new Date().toLocaleString();\n    } catch(e){\n      document.getElementById('result').style.display='none';\n      document.getElementById('errBox').style.display='block';\n      document.getElementById('errBox').textContent='Error: '+e.message;\n    } finally{\n      btn.disabled=false; btn.textContent='Run AI Analysis';\n    }\n  }\n\n  // Live clock\n  setInterval(()=>{document.getElementById('clock').textContent=new Date().toLocaleTimeString()},1000);\n</script>\n</body>\n</html>"
      },
